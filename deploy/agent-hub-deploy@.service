# Installed by hand with deploy/install.sh; deploys never replace the installed unit.
[Unit]
Description=Agent Hub deploy %i

[Service]
Type=oneshot
WorkingDirectory=%h/agent-hub-prod
EnvironmentFile=%h/.config/agent-hub/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash %h/agent-hub-prod/scripts/deploy.sh %i
TimeoutStartSec=30min
