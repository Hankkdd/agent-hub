# Installed by hand with deploy/install.sh; deploys never replace the installed unit.
[Unit]
Description=Agent Hub production
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/agent-hub-prod
EnvironmentFile=%h/.config/agent-hub/env
Environment=AGENT_HUB_SERVE_WEB=1
Environment=AGENT_HUB_DEPLOY_ENABLED=1
ExecStart=%h/.local/bin/mise exec -- pnpm --filter @agent-hub/server start
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
